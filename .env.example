# Copy to .env and fill in what you have. Nothing is required to boot the
# service - DuckDuckGo web search works out of the box with zero cost and no API keys!

PORT=8080

# --- X (Twitter) API v2, used by POST /accounts/:handle/analyze ---
# Needs at least the free/basic tier's "Bearer Token" (App-only auth).
# Automatically resolves @handles to user IDs and fetches full note_tweet text.
# Note: /import (fed from the account's official data archive JSON) works
# without any X API token at all!
X_BEARER_TOKEN=

# --- Web Search Backend ---
# If nothing is set below, the service automatically uses DuckDuckGo for FREE
# (0 API keys, 0 credit cards, 0 cost).
#
# 1. Google Programmable Search Engine (100 searches/day FREE):
#    https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
#
# 2. Brave Search API (2,000 queries/month FREE):
#    https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
#
# 3. SerpApi (alternative search backend):
SERPAPI_API_KEY=
#
# Optional: disable web searching entirely (everything scores 100% original)
# DISABLE_SEARCH=1

# --- Cost-Effective LLM Originality Judge ---
# 1. Google Gemini Flash (RECOMMENDED: FREE tier available on Google AI Studio!)
#    Get a key at https://aistudio.google.com/
#    Offers 15 RPM / 1,500 requests/day for $0, and $0.075/1M tokens if paid.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Anthropic Claude (alternative fallback)
ANTHROPIC_API_KEY=

# Set to 1 to disable LLM judging and use fast lexical scoring only:
# DISABLE_LLM_JUDGE=1

# Optional: tracing verbosity, e.g. originality_checker=debug
RUST_LOG=originality_checker=info

